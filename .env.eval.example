# Copy to .env.eval. Evaluation credentials are intentionally separate.
# Database credentials are fixed inside the isolated Docker network and are not host-exposed.
SECRET_KEY=change-me-to-another-long-random-value
CODESAGE_EVAL_EMAIL=demo@example.com
CODESAGE_EVAL_PASSWORD=demo123

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_DISABLE_STREAMING=false

PR_NODE_ID=pr-node-eval-local
PR_NODE_AGENT_VERSION=1
PR_NODE_PROTOCOL_VERSION=1
PR_NODE_CAPABILITIES=pr.diff.read,repo.snapshot.read,review.finalize

JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
GITHUB_TOKEN=
NO_PROXY=localhost,127.0.0.1,phoenix,eval-api,eval-postgres,eval-redis
