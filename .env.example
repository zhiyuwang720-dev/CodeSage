# Copy to .env for the normal product stack. Never commit real secrets.
POSTGRES_USER=codesage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codesage
SECRET_KEY=change-me-to-a-long-random-value

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_DISABLE_STREAMING=false

# Stable logical identity for a standalone PR node process.
PR_NODE_ID=pr-node-local
PR_NODE_AGENT_VERSION=1
PR_NODE_PROTOCOL_VERSION=1
PR_NODE_CAPABILITIES=pr.diff.read,repo.snapshot.read,review.finalize

# Optional repository credentials.
GITHUB_TOKEN=
GITLAB_TOKEN=
GITEA_TOKEN=
# Docker Desktop may require these for localhost access from host-side tools.
NO_PROXY=localhost,127.0.0.1,postgres,redis,phoenix,backend
